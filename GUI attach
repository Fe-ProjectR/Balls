local function populateList()
	for _, child in ipairs(ScrollingFrame:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end

	local ySize = 0
	local filterText = string.lower(SearchBar.Text)
	local rowHeight = layout.mobile and 56 or 50
	local index = 0

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local dName = string.lower(plr.DisplayName)
			local uName = string.lower(plr.Name)

			if filterText == "" or string.find(dName, filterText) or string.find(uName, filterText) then
				index = index + 1

				local PlayerFrame = Instance.new("Frame")
				PlayerFrame.Size = UDim2.new(1, 0, 0, rowHeight)
				PlayerFrame.ZIndex = 2
				PlayerFrame.Parent = ScrollingFrame
				addGlassLook(PlayerFrame, 14, Theme.chip, 0.92, 0.82)

				local targetTransparency = PlayerFrame.BackgroundTransparency
				PlayerFrame.BackgroundTransparency = 1
				local rowIndex = index
				task.delay(rowIndex * 0.03, function()
					if PlayerFrame.Parent then
						TweenService:Create(PlayerFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { BackgroundTransparency = targetTransparency }):Play()
					end
				end)

				local imgSize = rowHeight - 10
				local ProfileImage = Instance.new("ImageLabel")
				ProfileImage.Size = UDim2.new(0, imgSize, 0, imgSize)
				ProfileImage.Position = UDim2.new(0, 5, 0, 5)
				ProfileImage.BackgroundTransparency = 1
				ProfileImage.Image = Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
				ProfileImage.ZIndex = 3
				ProfileImage.Parent = PlayerFrame

				local imgCorner = Instance.new("UICorner")
				imgCorner.CornerRadius = UDim.new(1, 0)
				imgCorner.Parent = ProfileImage

				local NameLabel = Instance.new("TextLabel")
				NameLabel.Size = UDim2.new(1, -(imgSize + 20), 1, 0)
				NameLabel.Position = UDim2.new(0, imgSize + 12, 0, 0)
				NameLabel.BackgroundTransparency = 1
				NameLabel.Text = plr.DisplayName .. "\n@" .. plr.Name
				NameLabel.TextColor3 = Theme.textPrimary
				NameLabel.TextXAlignment = Enum.TextXAlignment.Left
				NameLabel.Font = Enum.Font.Gotham
				NameLabel.TextSize = layout.bodyTextSize - 1
				NameLabel.TextWrapped = true
				NameLabel.ZIndex = 3
				NameLabel.Parent = PlayerFrame

				local SelectBtn = Instance.new("TextButton")
				SelectBtn.Size = UDim2.new(1, 0, 1, 0)
				SelectBtn.BackgroundTransparency = 1
				SelectBtn.Text = ""
				SelectBtn.ZIndex = 3
				SelectBtn.Parent = PlayerFrame

				SelectBtn.MouseButton1Click:Connect(function()
					targetPlayer = plr
					SubtitleLabel.Text = "Target: " .. plr.DisplayName
				end)

				ySize = ySize + rowHeight + 8
			end
		end
	end
	ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

