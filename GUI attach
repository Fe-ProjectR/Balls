local function setMode(newIndex)
	currentModeIndex = ((newIndex - 1) % #modes) + 1
	local newMode = modes[currentModeIndex]

	local fadeOut = TweenService:Create(ModeLabel, TweenInfo.new(0.1), { TextTransparency = 1 })
	fadeOut:Play()
	fadeOut.Completed:Connect(function()
		ModeLabel.Text = newMode
		TweenService:Create(ModeLabel, TweenInfo.new(0.15), { TextTransparency = 0 }):Play()
	end)

	WhoSettingsFrame.Visible = modesUsingWhoSettings[newMode] == true
end

