SwitchTrack.MouseButton1Click:Connect(function()
	isAttached = not isAttached

	if isAttached then
		local myChar = LocalPlayer.Character
		if not myChar or not targetPlayer or not targetPlayer.Character then
			isAttached = false
			return
		end

		setSwitchVisual(true)

		originalCameraType = Camera.CameraType
		Camera.CameraType = Enum.CameraType.Custom
		if cameraLockConnection then cameraLockConnection:Disconnect() end
		cameraLockConnection = RunService.RenderStepped:Connect(function()
			if Camera.CameraType ~= Enum.CameraType.Custom then
				Camera.CameraType = Enum.CameraType.Custom
			end
		end)

		attachConnection = RunService.Heartbeat:Connect(function()
			if isAttached and targetPlayer.Character and myChar.Parent then
				local currentTargetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
				local currentMyRoot = myChar:FindFirstChild("HumanoidRootPart")
				local myHumanoid = myChar:FindFirstChild("Humanoid")

				if currentTargetRoot and currentMyRoot then
					pcall(function() sethiddenproperty(currentMyRoot, "PhysicsRepRootPart", currentTargetRoot) end)

					local currentMode = modes[currentModeIndex]
					local baseCFrame = currentTargetRoot.CFrame
					local offsetCFrame = CFrame.new(0, 0, 3)
					local wantsSit = false
					local wantsPlatformStand = false

					if currentMode == "Default" then
						offsetCFrame = CFrame.new(0, 0, 3)
					elseif currentMode == "Tool" then
						local rightArm = targetPlayer.Character:FindFirstChild("Right Arm") or targetPlayer.Character:FindFirstChild("RightHand")
						if rightArm then
							baseCFrame = rightArm.CFrame
							offsetCFrame = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(-90), 0, 0)
						else
							offsetCFrame = CFrame.new(1.5, -0.5, -1) * CFrame.Angles(math.rad(-90), 0, 0)
						end
					elseif currentMode == "Front" then
						offsetCFrame = CFrame.new(0, 0, -2.5) * CFrame.Angles(0, math.rad(180), 0)
					elseif currentMode == "Head" then
						local head = targetPlayer.Character:FindFirstChild("Head")
						if head then
							baseCFrame = head.CFrame
							offsetCFrame = CFrame.new(0, 1.5, 0)
						else
							offsetCFrame = CFrame.new(0, 2.5, 0)
						end
						wantsSit = true
					elseif currentMode == "Backpack" then
						offsetCFrame = CFrame.new(0, 0.5, 1.2)
						wantsSit = true
					elseif currentMode == "Who?" then
						local baseBehind = 1.5
						local zOffset = baseBehind + math.abs(math.sin(os.clock() * whoMoveSpeed)) * whoMoveDistance
						offsetCFrame = CFrame.new(0, 0, zOffset)
					elseif currentMode == "Who?2" then
						local head = targetPlayer.Character:FindFirstChild("Head")
						local baseFront = -0.6
						local zOffset = baseFront - (math.abs(math.sin(os.clock() * whoMoveSpeed)) * whoMoveDistance)

						if head then
							baseCFrame = head.CFrame
							offsetCFrame = CFrame.new(0, 0, zOffset) * CFrame.Angles(0, math.rad(180), 0)
						else
							offsetCFrame = CFrame.new(0, 1.5, zOffset) * CFrame.Angles(0, math.rad(180), 0)
						end
					elseif currentMode == "Orbit" then
						local angle = os.clock() * whoMoveSpeed
						local radius = 3 + whoMoveDistance
						local orbitPos = currentTargetRoot.Position + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
						baseCFrame = CFrame.new(orbitPos, currentTargetRoot.Position)
						offsetCFrame = CFrame.new(0, 0, 0)
					elseif currentMode == "Ceiling" then
						local head = targetPlayer.Character:FindFirstChild("Head")
						local originPos = head and head.Position or currentTargetRoot.Position
						local rotationOnly = currentTargetRoot.CFrame - currentTargetRoot.CFrame.Position
						baseCFrame = CFrame.new(originPos + Vector3.new(0, 4, 0)) * rotationOnly * CFrame.Angles(math.rad(180), 0, 0)
						offsetCFrame = CFrame.new(0, 0, 0)
					elseif currentMode == "Shadow" then
						local rotationOnly = currentTargetRoot.CFrame - currentTargetRoot.CFrame.Position
						local feetPos = currentTargetRoot.Position - Vector3.new(0, 3, 0)
						baseCFrame = CFrame.new(feetPos) * rotationOnly
						offsetCFrame = CFrame.new(0, 0, 2) * CFrame.Angles(math.rad(90), 0, 0)
					elseif currentMode == "Mirror" then
						baseCFrame = currentTargetRoot.CFrame
						offsetCFrame = CFrame.new(0, 0, -2.5) * CFrame.Angles(0, math.rad(180), 0) * CFrame.Angles(0, 0, math.rad(180))
					elseif currentMode == "Helicopter" then
						local head = targetPlayer.Character:FindFirstChild("Head")
						local pivotPos = (head and head.Position or currentTargetRoot.Position) + Vector3.new(0, 1, 0)
						local spinAngle = os.clock() * (whoMoveSpeed * 20)

						baseCFrame = CFrame.new(pivotPos) * CFrame.Angles(0, spinAngle, 0)
						offsetCFrame = CFrame.Angles(math.rad(-90), 0, 0)
						wantsPlatformStand = true
					end

					if myHumanoid then
						if wantsSit then
							myHumanoid.PlatformStand = false
							myHumanoid.Sit = true
						elseif wantsPlatformStand then
							myHumanoid.Sit = false
							myHumanoid.PlatformStand = true
						else
							myHumanoid.Sit = false
							myHumanoid.PlatformStand = false
						end
					end

					currentMyRoot.CFrame = baseCFrame * offsetCFrame
					currentMyRoot.Velocity = Vector3.zero
					currentMyRoot.RotVelocity = Vector3.zero
				end
			else
				if attachConnection then
					attachConnection:Disconnect()
					attachConnection = nil
				end
			end
		end)
	else
		setSwitchVisual(false)
		if attachConnection then attachConnection:Disconnect(); attachConnection = nil end

		if cameraLockConnection then cameraLockConnection:Disconnect(); cameraLockConnection = nil end
		if originalCameraType then
			Camera.CameraType = originalCameraType
			originalCameraType = nil
		end

		pcall(function()
			local myChar = LocalPlayer.Character
			if myChar then
				local myRoot = myChar:FindFirstChild("HumanoidRootPart")
				local myHumanoid = myChar:FindFirstChild("Humanoid")
				if myRoot then sethiddenproperty(myRoot, "PhysicsRepRootPart", nil) end
				if myHumanoid then
					myHumanoid.Sit = false
					myHumanoid.PlatformStand = false
				end
			end
		end)
	end
end)