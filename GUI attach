local function isMobileDevice()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function getLayoutProfile()
	local viewport = Camera.ViewportSize
	local mobile = isMobileDevice() or viewport.X < 550

	if mobile then
		local width = math.clamp(viewport.X * 0.9, 270, 340)
		local height = math.clamp(viewport.Y * 0.74, 460, 580)
		return {
			mobile = true,
			size = UDim2.new(0, width, 0, height),
			titleTextSize = 19,
			bodyTextSize = 15,
			rowHeight = 54,
			padding = 18,
			gap = 14,
			cardRadius = 26,
			chipRadius = 16,
		}
	else
		return {
			mobile = false,
			size = UDim2.new(0, 340, 0, 480),
			titleTextSize = 17,
			bodyTextSize = 14,
			rowHeight = 42,
			padding = 14,
			gap = 10,
			cardRadius = 22,
			chipRadius = 14,
		}
	end
end

